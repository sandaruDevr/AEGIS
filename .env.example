# Server Configuration
PORT=3000
HOST=localhost

# Server Security
# AUTH_TOKEN: Protects all API + WebSocket endpoints with Bearer token auth
# Required if HOST=0.0.0.0 (binding to all interfaces). Optional for localhost.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=

# LLM Provider (openrouter | openai)
LLM_PROVIDER=openrouter

# OpenRouter API Key
OPENROUTER_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Default Model (leave empty to pick from UI)
DEFAULT_MODEL=

# Summary Model (used by context summarizer for trimmed conversation summaries)
# Use a cheaper/faster model to save tokens. Leave empty to use DEFAULT_MODEL.
# Examples: openai/gpt-4o-mini, google/gemini-flash-1.5, meta-llama/llama-3.1-8b-instruct
SUMMARY_MODEL=

# Agent Temperature (0.0 - 1.0)
AGENT_TEMPERATURE=0.7

# Playwright Settings
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# WSL2 Settings
WSL_ENABLED=true
WSL_DEFAULT_TIMEOUT=30000

# AEGIS Platform
# Default scope class for agent runs: web_app | network | full
AGENT_SCOPE=web_app
# WAF: async LLM triage for escalated (low-confidence) decisions. Off = rule + anomaly only.
WAF_LLM_TRIAGE=false

# Jev (TypeSafe decision model) — typed, calibrated WAF triage for escalated decisions.
# Provider "openrouter" (default) uses your existing OPENROUTER_API_KEY — no extra key needed.
# Provider "typesafe" uses JEV_API_KEY from jevtypesafeai.com instead.
# Without a key the WAF runs unchanged: escalated decisions stay held for review.
JEV_PROVIDER=openrouter
JEV_MODEL=typesafe/jev-1.13
JEV_API_KEY=

# Credential Vault (authenticated scanning)
# Encrypts the sample test credentials you save per website (AES-256-GCM).
# Set a strong secret in production; if empty, a local key file is generated.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_SECRET=

# Anti-Detection / Proxy Settings
# NODE_PROXY: Route Node.js fetch() calls (make_request, check_security_headers) through proxy
# BROWSER_PROXY: Route Playwright browser traffic through proxy
# WSL_PROXY: Route WSL2 tool traffic (nmap, curl, etc.) through proxy
# All accept: http://host:port, https://host:port, socks5://host:port
# Leave empty if VPN handles all routing at OS level
NODE_PROXY=
BROWSER_PROXY=
WSL_PROXY=

# Python Settings (for execute_python_file tool)
# Leave empty to auto-detect. Set to full path if python is not in PATH.
# Example: C:\Users\HP\AppData\Local\Programs\Python\Python311\python.exe
PYTHON_PATH=
