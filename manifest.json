{
  "manifest_version": 3,
  "name": "CyberSec Agent - Vulnerability Assessment Tool",
  "version": "2.0.0",
  "key": "",
  "description": "AI-powered cybersecurity expert extension for vulnerability assessment, penetration testing, and security auditing with WSL2 tool integration.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open Agentic AI Panel"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}
